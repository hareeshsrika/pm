        "name": "My Project",
        "created_at": "2026-01-01T00:00:00Z",
        "updated_at": "2026-01-01T00:00:00Z"
      }
    ],
    "columns": [
      {
        "id": "col-backlog",
        "board_id": "board-user-1",
        "title": "Backlog",
        "position": 0
      }
    ],
    "cards": [
      {
        "id": "card-1",
        "board_id": "board-user-1",
        "column_id": "col-backlog",
        "title": "Align roadmap themes",
